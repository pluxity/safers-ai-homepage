---
import { ArrowDown } from "lucide-react";

import Layout from "../layouts/Layout.astro";
import CommonBase from "../components/react/services/CommonBase";
import ServiceDetails from "../components/react/services/ServiceDetails";
import Configurator from "../components/react/services/Configurator";
import { services } from "../data/content";
---
<Layout
  title="서비스 | Safers 세이퍼스 건설현장 안전관리"
  description="현장 3D 통합관리, AI 안전감지·블랙박스, AI 대화형 관제, AI 보건관리, 실시간 CCTV 관제, 중장비 연동 관리까지. 우리 현장에 맞는 구성을 직접 만들어 보세요."
>
  <section class="bg-ink text-ink-foreground">
    <div class="mx-auto grid max-w-7xl items-end gap-14 px-5 pt-20 pb-24 lg:grid-cols-[1.1fr_1fr] lg:px-8 lg:pt-28">
      <div>
        <p class="eyebrow-lg text-primary-bright">서비스</p>
        <h1 class="mt-6 text-[2.5rem] font-extrabold display-tight sm:text-6xl lg:text-[4rem]">
          현장 규모와 필요에 따라,
          <br />
          선택하고 확장하는 안전관리.
        </h1>
        <p class="mt-7 max-w-xl text-lg text-ink-muted sm:text-xl">
          모든 현장은 3D 통합관리에서 시작합니다. 그 위에 필요한 서비스를 더하고, 현장이 늘어나면 전국을 한 화면으로 넓힙니다.
        </p>
      </div>

      <nav aria-label="선택형 서비스 바로가기">
        <p class="text-[0.95rem] font-semibold text-primary-bright">선택형 서비스 바로가기</p>
        <ul class="mt-3 border-t border-ink-border">
          {services.map((s) => (
            <li class="border-b border-ink-border">
              <a href={`#${s.id}`} class="group flex items-center gap-5 py-4 transition-colors">
                <span class="font-mono text-ink-muted transition-colors group-hover:text-primary-bright">{s.no}</span>
                <span class="flex-1 text-lg font-semibold transition-transform group-hover:translate-x-1 sm:text-xl">{s.name}</span>
                <ArrowDown className="size-5 text-ink-muted transition-all group-hover:translate-y-0.5 group-hover:text-primary-bright" />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <CommonBase client:visible />
  <ServiceDetails client:visible />
  <Configurator client:visible />
</Layout>
