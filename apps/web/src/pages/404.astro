---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import ArrowRight from "../assets/icons/arrow-right.svg";
---
<Layout title="페이지를 찾을 수 없습니다 | Safers 세이퍼스" hideFooter noActiveMenu>
  <section class="relative flex flex-1 items-center overflow-hidden bg-ink text-ink-foreground">
    <div class="absolute -right-40 top-1/2 size-150 -translate-y-1/2 rounded-full bg-primary/20 blur-3xl"></div>
    <p class="pointer-events-none absolute -right-8 bottom-0 select-none text-[28vw] font-black leading-none text-ink-foreground/5">
      404
    </p>

    <div class="relative mx-auto w-full max-w-7xl px-5 lg:px-8">
      <p class="eyebrow-lg text-primary-bright">404 · PAGE NOT FOUND</p>
      <h1 class="mt-6 text-5xl font-extrabold display-tight md:text-7xl">
        페이지를<br />찾을 수 없습니다.
      </h1>
      <p class="mt-6 text-lg text-ink-muted sm:text-xl">
        주소가 바뀌었거나 삭제된 페이지입니다.<br />
        아래 버튼으로 원하시는 곳으로 이동해 주세요.
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        <Button href="/" size="xl">홈으로 <ArrowRight /></Button>
      </div>
    </div>
  </section>
</Layout>
