---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";

import logo from "../assets/logo.svg";
import ArrowUpRight from "../assets/icons/arrow-up-right.svg";
import { contact, pluxityUrl } from "../data/content";
import { defaultLang, translate } from "../i18n";

const lang = Astro.currentLocale ?? defaultLang;
const { nav, footer } = translate(lang);

const menus = [
  { path: "/", label: nav.platform },
  { path: "/services", label: nav.services },
  { path: "/contact", label: nav.contact },
];
---
<footer class="bg-ink text-ink-muted">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 lg:grid-cols-[1.4fr_1fr_1.2fr] lg:px-8">
    <div>
      <Image src={logo} alt="safers" class="h-6.5 w-auto" loading="lazy" />
      <p class="mt-5 max-w-sm leading-relaxed">{footer.description}</p>
      <a
        href={pluxityUrl}
        target="_blank"
        rel="noopener"
        class="mt-6 inline-flex items-center gap-2 rounded-md border border-ink-border px-4 py-2.5 font-medium text-ink-foreground transition-colors hover:bg-ink-raised"
      >
        {footer.pluxityButton} <ArrowUpRight class="size-4" />
      </a>
    </div>

    <div>
      <p class="font-semibold text-ink-foreground">{footer.menuTitle}</p>
      <ul class="mt-4 space-y-3">
        {menus.map((menu) => (
          <li><a href={getRelativeLocaleUrl(lang, menu.path)} class="hover:text-ink-foreground">{menu.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="leading-relaxed">
      <p class="font-semibold text-ink-foreground">{footer.contactTitle}</p>
      <p class="mt-4">{footer.company}</p>
      <p class="mt-1">{footer.address}</p>
      <p class="mt-3">
        T. {contact.phone}
        <br />
        E. <a href={`mailto:${contact.email}`} class="hover:text-ink-foreground">{contact.email}</a>
      </p>
    </div>
  </div>

  <div class="border-t border-ink-border">
    <div class="mx-auto flex max-w-7xl flex-col justify-between gap-2 px-5 py-6 text-[0.95rem] sm:flex-row lg:px-8">
      <span>{footer.copyright}</span>
      <span>Safers by PLUXITY</span>
    </div>
  </div>
</footer>
