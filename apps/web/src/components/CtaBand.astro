---
import { getRelativeLocaleUrl } from "astro:i18n";
import { ArrowRight } from "lucide-react";

import Button from "./ui/Button.astro";
import { contact } from "../data/content";
import { defaultLang, translate } from "../i18n";

const lang = Astro.currentLocale ?? defaultLang;
const text = translate(lang).cta;
---
<section class="bg-primary text-primary-foreground">
  <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-10 px-5 py-24 lg:flex-row lg:items-end lg:px-8">
    <div>
      <h2 class="text-4xl font-bold display-tight sm:text-5xl lg:text-6xl">
        {text.title[0]}
        <br />
        {text.title[1]}
      </h2>
      <p class="mt-6 max-w-xl text-lg opacity-90 sm:text-xl">{text.description}</p>
    </div>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
      <Button href={getRelativeLocaleUrl(lang, "/contact")} variant="inverse" size="xl">
        {text.button} <ArrowRight />
      </Button>
      <a href={`tel:${contact.phone.replace(/\s/g, "")}`} class="text-lg font-semibold opacity-90 hover:opacity-100">
        T. {contact.phone}
      </a>
    </div>
  </div>
</section>
