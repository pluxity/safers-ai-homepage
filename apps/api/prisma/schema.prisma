// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── enum ───────────────────────
enum Locale {
  KO
  EN

  @@map("locale")
}

enum PostCategory {
  COMPANY /// 회사 소식
  SAFERS /// Safers 소식
  NOTICE

  @@map("post_category")
}

enum PostStatus {
  DRAFT
  PUBLISHED

  @@map("post_status")
}

/// 관심 서비스 (문의 폼에서 복수 선택)
enum InquiryService {
  PLATFORM /// 통합 플랫폼
  AI_SAFETY_BLACKBOX /// AI 안전감지·블랙박스
  AI_CONVERSATIONAL /// AI 대화형 관제
  AI_HEALTH /// AI 보건관리
  CCTV_MONITORING /// 실시간 CCTV 관제
  HEAVY_EQUIPMENT /// 중장비 연동 관리
  PARTNERSHIP /// 제휴·마케팅

  @@map("inquiry_service")
}

/// 운영 현장 수
enum SiteCount {
  ONE /// 1곳
  TWO_TO_FIVE /// 2–5곳
  SIX_OR_MORE /// 6곳 이상
  UNDECIDED /// 미정

  @@map("site_count")
}

/// CCTV 환경
enum CctvEnv {
  EXISTING /// 기존 CCTV 활용
  NEW /// 새로 구축
  UNDECIDED /// 미정

  @@map("cctv_env")
}

enum InquiryStatus {
  NEW
  DONE
  SPAM

  @@map("inquiry_status")
}

// ─── 소식 (posts) ────────────────
model Post {
  id             Int          @id @default(autoincrement())
  locale         Locale       @default(KO)
  category       PostCategory
  title          String       @db.VarChar(200)
  summary        String       @db.VarChar(300)
  body_html      String
  thumbnail_path String?      @db.VarChar(300)
  source_url     String?      @db.VarChar(500)
  status         PostStatus   @default(DRAFT)
  published_at   DateTime?    @db.Timestamptz
  created_at     DateTime     @default(now()) @db.Timestamptz
  updated_at     DateTime     @default(now()) @updatedAt @db.Timestamptz

  @@index([locale, status, published_at(sort: Desc), id(sort: Desc)])
  @@map("posts")
}

// ─── 문의 (inquiry) ────────────
model Inquiry {
  id                Int              @id @default(autoincrement())
  locale            Locale           @default(KO)
  services          InquiryService[]
  site_count        SiteCount
  cctv_env          CctvEnv
  name              String           @db.VarChar(50)
  company           String           @db.VarChar(100)
  email             String           @db.VarChar(254)
  phone             String           @db.VarChar(30)
  message           String?
  privacy_agreed_at DateTime         @db.Timestamptz
  marketing_agreed  Boolean          @default(false)
  status            InquiryStatus    @default(NEW) /// 처리 상태 (관리자)
  memo              String? /// 내부 메모 (관리자)
  created_at        DateTime         @default(now()) @db.Timestamptz

  @@index([status, created_at(sort: Desc), id(sort: Desc)])
  @@map("inquiries")
}
